{
  "name": "coderax-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical Coderax CLI: chat, Work mode, products, login, health, OpenAPI discovery, and authenticated calls",
  "type": "module",
  "bin": {
    "coderax": "src/cli.js"
  },
  "files": [
    "src/",
    "docs/CONTRACT.md",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.js --help",
    "check": "node scripts/check-syntax.mjs",
    "test": "node scripts/run-tests.mjs all",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "verify:contract": "node scripts/verify-contract.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "release:build": "node scripts/build-release.mjs"
  }
}
